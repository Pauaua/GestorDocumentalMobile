# {{ managed_header }}
# Variables de entorno del Gestor Documental.
# Los valores no secretos se leen desde SSM Parameter Store ({{ ssm_parameter_prefix }}) al desplegar.
# DATABASE_URL y los secretos JWT los carga la app en runtime desde SSM con el rol IAM
# de la instancia (CONFIG_SOURCE=ssm): nunca quedan escritos en disco.
NODE_ENV=production
PORT={{ app_port }}
CONFIG_SOURCE=ssm
SSM_PARAMETER_PREFIX={{ ssm_parameter_prefix }}
AWS_REGION={{ aws_region }}
S3_BUCKET={{ ssm_s3_bucket }}
CORS_ORIGINS={{ ssm_cors_origins }}
LOG_FILE={{ app_log_dir }}/app.log
LOG_LEVEL={{ log_level }}
WEB_DIST_DIR={{ app_dir }}/current/public
RATE_LIMIT_MAX={{ rate_limit_max }}
# Outbox de avisos (correo por SES y push por Expo); MAIL_TRANSPORT y MAIL_FROM vienen de SSM.
NOTIFICATIONS_WORKER=true
PUSH_TRANSPORT=expo
APP_VERSION={{ release_id }}

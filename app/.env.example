# URL de la API. En desarrollo web: http://localhost:3000
# En el teléfono (Expo Go / dev build) usa la IP local de tu PC, p. ej. http://192.168.1.20:3000
# En producción (web servida por Express) puede quedar vacía: se usa el mismo origen.
EXPO_PUBLIC_API_URL=http://localhost:3000

# Multi-tenant: cada colegio entra por <slug>.EXPO_PUBLIC_BASE_DOMAIN (p. ej. demo.rtlco.cl).
# En la web con ese dominio el colegio se toma del subdominio; en la app se pide el código del colegio.
EXPO_PUBLIC_BASE_DOMAIN=
# Colegio por defecto en desarrollo (el del seed), para no escribir el código en cada prueba.
EXPO_PUBLIC_SCHOOL=demo

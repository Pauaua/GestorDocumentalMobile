# --- Desarrollo local (docker compose up -d && npm run s3:init) ---
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://gestor:gestor@localhost:5432/gestor_documental?schema=public

JWT_ACCESS_SECRET=cambia-este-secreto-de-acceso-de-al-menos-32-caracteres
JWT_REFRESH_SECRET=cambia-este-secreto-de-refresco-de-al-menos-32-caracteres
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=7

AWS_REGION=us-east-1
S3_BUCKET=gestor-documental-dev
# S3 local (RustFS/MinIO) en lugar de Amazon S3. En AWS se dejan vacías y se usa el rol IAM
S3_ENDPOINT=http://localhost:9000
# Endpoint que ve el navegador o el teléfono (usa la IP de tu PC para probar en móvil)
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_FORCE_PATH_STYLE=true
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin

# Orígenes permitidos por CORS (separados por coma); Expo web en dev corre en :8081
CORS_ORIGINS=http://localhost:8081,http://localhost:19006

# En producción: CONFIG_SOURCE=ssm y SSM_PARAMETER_PREFIX=/rtlco
# para leer DATABASE_URL y los secretos JWT desde SSM Parameter Store.
CONFIG_SOURCE=env
SSM_PARAMETER_PREFIX=/rtlco

# Archivo de log (vacío = stdout). En EC2: /var/log/gestor-documental/app.log
LOG_FILE=
LOG_LEVEL=info

RATE_LIMIT_MAX=1200
LOGIN_RATE_LIMIT_MAX=20

# Carpeta con el build web de la app (npx expo export -p web)
WEB_DIST_DIR=

# Multi-tenant. En producción BASE_DOMAIN llega desde SSM (<slug>.rtlco.cl → colegio).
# En desarrollo: http://demo.localhost:3000 resuelve el colegio "demo" sin configurar nada,
# o DEFAULT_SCHOOL_SLUG=demo para usar ese colegio cuando la solicitud no indique ninguno.
BASE_DOMAIN=
DEFAULT_SCHOOL_SLUG=demo
